// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * Redmi AX3000 (RA81), 32-bit ARM build.
 *
 * The vendor U-Boot is a 32-bit ARM binary, so it cannot start an AArch64
 * kernel. The 'arm' subtarget therefore builds this board for 32-bit ARM,
 * reusing the AArch64 SoC/ESS/QCN6122 descriptions and overriding only the
 * genuinely architecture specific bits (the PMU compatible).
 *
 * The partition table is NOT provided through SMEM on this device: U-Boot
 * passes it on the kernel command line (mtdparts=nand0:...(fs),${msmparts}),
 * which is why there is no "partitions" node here and why the arm subtarget
 * disables CONFIG_MTD_QCOMSMEM_PARTS.
 */

/dts-v1/;

#include "../../../../arm64/boot/dts/qcom/ipq5018.dtsi"
#include "../../../../arm64/boot/dts/qcom/ipq5018-ess.dtsi"
#include "../../../../arm64/boot/dts/qcom/ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Redmi AX3000";
	compatible = "redmi,ax3000", "qcom,ipq5018";

	pmu {
		compatible = "arm,cortex-a7-pmu";
	};

	aliases {
		serial0 = &blsp1_uart1;
		led-boot = &led_system_blue;
		led-failsafe = &led_system_yellow;
		led-running = &led_system_blue;
		led-upgrade = &led_system_yellow;
		label-mac-device = <&dp1>;
	};

	chosen {
		/*
		 * Xiaomi's U-Boot sets ubi.mtd=rootfs or rootfs_1 depending on
		 * the booted slot and passes the partition table via mtdparts,
		 * so neither must be overridden here. Inside the UBI the kernel
		 * is volume 0 and the rootfs is volume 1.
		 */
		bootargs-append = " root=/dev/ubiblock0_1 swiotlb=1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset-button {
			label = "reset";
			gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		mesh-button {
			label = "mesh";
			gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led_system_blue: system-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 19 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led_system_yellow: system-yellow {
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 17 GPIO_ACTIVE_HIGH>;
		};

		led_internet_blue: internet-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WAN;
			gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
		};

		led_internet_yellow: internet-yellow {
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_WAN;
			gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";

	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-step-size = <512>;
		nand-ecc-strength = <8>;
		nand-bus-width = <8>;

		/*
		 * Deliberately no "partitions" node: it would make the kernel
		 * ignore the mtdparts= passed by U-Boot on the command line,
		 * and this board has no SMEM partition table to fall back on.
		 * The UBI volume to boot from is selected by ubi.mtd=rootfs /
		 * rootfs_1, which U-Boot also passes.
		 */
	};
};

&switch {
	status = "okay";

	switch_mac_mode = <MAC_MODE_SGMII_CHANNEL0>;

	qcom,port_phyinfo {
		/* MAC0 -> GE Phy --- MDI --- QCA8337 Phy4 (port 5) */
		port@0 {
			port_id = <1>;
			mdiobus = <&mdio0>;
			phy_address = <7>;
		};

		/* MAC1 -> Uniphy --- SGMII --- QCA8337 SerDes (port 6) */
		port@1 {
			port_id = <2>;
			mdiobus = <&mdio1>;
			forced-speed = <1000>;
			forced-duplex = <1>;
		};
	};
};

/* MAC0 -> GE Phy */
&dp1 {
	status = "okay";
};

/* MAC1 -> SGMII -> QCA8337 */
&dp2 {
	status = "okay";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&mdio0 {
	status = "okay";
};

/* MAC0 -> GE Phy -> QCA8337 Phy4 */
&ge_phy {
	qcom,dac-preset-short-cable;
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;

	/* QCA8337 Phy0 -> LAN1 */
	qca8337_0: ethernet-phy@0 {
		reg = <0>;
	};

	/* QCA8337 Phy1 -> LAN2 */
	qca8337_1: ethernet-phy@1 {
		reg = <1>;
	};

	/* QCA8337 Phy2 -> LAN3 */
	qca8337_2: ethernet-phy@2 {
		reg = <2>;
	};

	/* QCA8337 Phy3 -> WAN */
	qca8337_3: ethernet-phy@3 {
		reg = <3>;
	};

	/* QCA8337 Phy4 -> IPQ5000 GE Phy */
	qca8337_4: ethernet-phy@4 {
		reg = <4>;
	};

	/* QCA8337 switch */
	ethernet-switch@11 {
		compatible = "qca,qca8337";
		reg = <0x11>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@1 {
				reg = <1>;
				label = "lan1";
				phy-handle = <&qca8337_0>;
			};

			port@2 {
				reg = <2>;
				label = "lan2";
				phy-handle = <&qca8337_1>;
			};

			port@3 {
				reg = <3>;
				label = "lan3";
				phy-handle = <&qca8337_2>;
			};

			port@4 {
				reg = <4>;
				label = "wan";
				phy-handle = <&qca8337_3>;
			};

			/*
			 * QCA8337 Phy4 is wired to the IPQ5000 GE PHY (MAC0).
			 * Same wiring as the SPNMX56 upstream: the GE PHY link
			 * goes to MAC0 (dp1).
			 */
			port@5 {
				reg = <5>;
				phy-handle = <&qca8337_4>;
				phy-mode = "gmii";
				ethernet = <&dp1>;
			};

			/* CPU port ---SGMII---> IPQ5000 MAC1 */
			port@6 {
				reg = <6>;
				phy-mode = "sgmii";
				ethernet = <&dp2>;
				qca,sgmii-enable-pll;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
	};
};

&tlmm {
	button_pins: button-state {
		pins = "gpio23", "gpio25";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	leds_pins: leds-state {
		pins = "gpio17", "gpio19", "gpio20", "gpio22";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio28", "gpio29";
		function = "blsp0_uart1";
		drive-strength = <8>;
		bias-disable;
	};
};

&q6v5_wcss {
	/* QCN6122 (PD2) is held in reset by GPIO 27 */
	boot-args = </*       type: */ 0x2 /* PCIE1 */
		     /*     length: */ 4
		     /*      PD id: */ 2
		     /* reset GPIO: */ 27
		     /*   reserved: */ 0 0>;
};

&wifi {
	status = "okay";

	/* IPQ5000 2.4 GHz; board id is reported by the target itself */
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd1";
	qcom,ath11k-fw-memory-mode = <2>;
	qcom,bdf-addr = <0x4c400000>;
};

&wifi1 {
	status = "okay";

	/* QCN6102 / QCN6122 5 GHz */
	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,ath11k-fw-memory-mode = <2>;
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;
};
