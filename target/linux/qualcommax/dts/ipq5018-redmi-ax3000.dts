/dts-v1/;

/*
 * The arm subtarget builds this same board for 32-bit ARM (the device's
 * bootloader cannot start an AArch64 kernel); ipq5018-arm.dtsi reuses the
 * arm64 SoC description with the arch specific bits overridden.
 */
#ifdef __ARM32__
#include "ipq5018-arm.dtsi"
#else
#include "ipq5018.dtsi"
#endif
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Redmi AX3000";
	compatible = "redmi,ax3000", "qcom,ipq5018";

	aliases {
		label-mac-device = <&gmac0>;
		led-boot = &led_system_blue;
		led-failsafe = &led_system_yellow;
		led-running = &led_system_blue;
		led-upgrade = &led_system_yellow;
		serial0 = &blsp1_uart1;
	};

	chosen {
		/*
		 * Xiaomi's U-Boot sets ubi.mtd=rootfs or rootfs_1 depending on
		 * the booted slot, so it must not be overridden here. Within the
		 * UBI the kernel is volume 0 and the rootfs is volume 1.
		 */
		bootargs-append = " root=/dev/ubiblock0_1 swiotlb=1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset-button {
			label = "reset";
			gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		mesh-button {
			label = "mesh";
			gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led_system_blue: system-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 19 GPIO_ACTIVE_HIGH>;
		};

		led_system_yellow: system-yellow {
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 17 GPIO_ACTIVE_HIGH>;
		};

		led_internet_blue: internet-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WAN;
			gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
		};

		led_internet_yellow: internet-yellow {
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_WAN;
			gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";

	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-step-size = <512>;
		nand-ecc-strength = <8>;
		nand-bus-width = <8>;

#ifndef __ARM32__
		/*
		 * On the 32-bit ARM build the partition table is NOT provided
		 * through SMEM: the vendor U-Boot passes it on the kernel
		 * command line (mtdparts=nand0:...(fs),${msmparts}), and the
		 * arm subtarget therefore disables CONFIG_MTD_QCOMSMEM_PARTS.
		 * Declaring qcom,smem-part there makes the kernel look for a
		 * table that does not exist, so it ends up without partitions
		 * and cannot find the rootfs (the device does not boot at all).
		 */
		partitions {
			compatible = "qcom,smem-part";

			partition-art {
				label = "0:ART";
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_art_0: macaddr@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};

					macaddr_art_6: macaddr@6 {
						compatible = "mac-base";
						reg = <0x6 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};
		};
#endif
	};
};

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_25MHZ>;
};

/* MAC0 -> GE Phy -> QCA8337 Phy4 */
&gmac0 {
	status = "okay";

#ifndef __ARM32__
	nvmem-cells = <&macaddr_art_6 (0)>;
	nvmem-cell-names = "mac-address";
#endif
};

/* MAC1 ---SGMII---> QCA8337 SerDes (DSA conduit) */
&gmac1 {
	status = "okay";

	phy-mode = "sgmii";

#ifndef __ARM32__
	nvmem-cells = <&macaddr_art_0 (0)>;
	nvmem-cell-names = "mac-address";
#endif

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&mdio0 {
	status = "okay";
};

/* IPQ5000 GE Phy -> QCA8337 Phy4 */
&ge_phy {
	qcom,dac-preset-short-cable;
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;

	/* QCA8337 Phy0 -> LAN1 */
	qca8337_0: ethernet-phy@0 {
		reg = <0>;
	};

	/* QCA8337 Phy1 -> LAN2 */
	qca8337_1: ethernet-phy@1 {
		reg = <1>;
	};

	/* QCA8337 Phy2 -> LAN3 */
	qca8337_2: ethernet-phy@2 {
		reg = <2>;
	};

	/* QCA8337 Phy3 -> WAN */
	qca8337_3: ethernet-phy@3 {
		reg = <3>;
	};

	/* QCA8337 Phy4 -> IPQ5000 GE Phy */
	qca8337_4: ethernet-phy@4 {
		reg = <4>;
	};

	/* QCA8337 switch */
	ethernet-switch@11 {
		compatible = "qca,qca8337";
		reg = <0x11>;

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet-port@1 {
				reg = <1>;
				label = "lan1";
				phy-handle = <&qca8337_0>;
			};

			ethernet-port@2 {
				reg = <2>;
				label = "lan2";
				phy-handle = <&qca8337_1>;
			};

			ethernet-port@3 {
				reg = <3>;
				label = "lan3";
				phy-handle = <&qca8337_2>;
			};

			ethernet-port@4 {
				reg = <4>;
				label = "wan";
				phy-handle = <&qca8337_3>;

#ifndef __ARM32__
				nvmem-cells = <&macaddr_art_6 (0)>;
				nvmem-cell-names = "mac-address";
#endif
			};

			/*
			 * The QCA8337 CPU port is port 6, wired over SGMII to MAC1.
			 * Port 5 (the GE PHY link) is deliberately not described:
			 * adding it stops the WAN port from working, exactly as on
			 * the other IPQ5018 boards upstream.
			 */
			ethernet-port@6 {
				reg = <6>;
				phy-mode = "sgmii";
				ethernet = <&gmac1>;
				qca,sgmii-enable-pll;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
	};
};

&tlmm {
	button_pins: button-state {
		pins = "gpio23", "gpio25";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	leds_pins: leds-state {
		pins = "gpio17", "gpio19", "gpio20", "gpio22";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio28", "gpio29";
		function = "blsp0_uart1";
		drive-strength = <8>;
		bias-disable;
	};
};

&q6v5_wcss {
	boot-args = </*       type: */ 0x2 /* PCIE1 */
		     /*     length: */ 4
		     /*      PD id: */ 2
		     /* reset GPIO: */ 27
		     /*   reserved: */ 0 0>;
};

&wifi {
	status = "okay";

	/*
	 * IPQ5000 2.4 GHz. The board id is reported by the target itself
	 * (M79: 16 / 0x10, M81: 36 / 0x24) and matched against the variants
	 * in the board-2.bin shipped by ipq-wifi-redmi_ax3000.
	 */
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,ath11k-fw-memory-mode = <2>;
	qcom,bdf-addr = <0x4c400000>;
};

&wifi1 {
	status = "okay";

	/* QCN6102 / QCN6122 5 GHz */
	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,ath11k-fw-memory-mode = <2>;
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;
};
