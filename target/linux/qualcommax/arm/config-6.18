# 32-bit ARM (armv7) essentials for IPQ50xx: the AArch64 oriented target
# config does not carry these, and without ARM_PATCH_PHYS_VIRT kconfig asks
# for PHYS_OFFSET (whose default 0 is invalid) and syncconfig fails.
CONFIG_ARCH_QCOM_RESERVE_SMEM=y
CONFIG_ARCH_MMAP_RND_BITS=8
CONFIG_ARM_PATCH_PHYS_VIRT=y
CONFIG_IPQ_APSS_5018=y
CONFIG_PCIE_DW_PLAT=y
# CONFIG_USB_QCOM_DIAG_BRIDGE is not set
CONFIG_VMSPLIT_2G=y
# CONFIG_VMSPLIT_3G is not set
